# vl53-eval: VL53L5CX 性能評価用ファーム (docs/2026-10-10-vl53l5cx-eval-plan.md)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# ドライバ例の注記どおり主タスクのスタックを増やす (7168以上)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# ドライバの VL53L5CX_WaitMs は vTaskDelay(ms/tick) のため1ms刻みにする
CONFIG_FREERTOS_HZ=1000
# 8x8・15Hz・全項目のCSVは約25KB/s。115200bpsでは足りないため 921600bps
# (IDF 5.5 では CUSTOM を選ばないと速度を変えられない)
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_VL53L5CX_NB_TARGET_PER_ZONE=1

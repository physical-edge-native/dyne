# Rust ビルド成果物
# ワークスペース (dyne-host, dyne-proto) のビルド出力
/target/
# 発注11の分離ビルド出力 (--target-dir target-exp1。full432掃引中の
# target/release ロック回避と掃引バイナリの由来保全のため分離)
/target-exp1/
# ワークスペース外で別ビルドするアクターは個別に指定
/crates/heat1d-actor/target/
/crates/heat1d-pinn-actor/target/
/crates/swarm-agent-actor/target/
/crates/heat2d-actor/target/
/crates/sdf2d-grid-actor/target/
/crates/mlp-actor/target/
/crates/wave2d-actor/target/
/crates/imu-fusion-actor/target/
/crates/wave2d-actor/target-small/
/crates/sdf2d-grid-actor/target-small/
/crates/sdf2d-grid-actor/target-small-std/
/crates/sdf2d-grid-actor/target-small-f32std/
/crates/sdf2d-grid-actor/target-f32/
/bench-c5/tools/recfuel/target/
# 上に挙げていないクレートの個別ビルド出力も含め、target/ という名前のフォルダはすべて無視する (2026-11-15)
target/

# Cargo.lock の方針:
# - dyne-host はバイナリなので Cargo.lock をコミットするのが Rust の慣例
#   (再現ビルドのため)。よってワークスペース直下の Cargo.lock は無視しない。
# - heat1d-actor 側の Cargo.lock も同様にコミット対象とする (無視しない)。

# 実行時の出力 (CSV は既定で %TEMP% / /tmp に出るが、リポジトリ内に
# 出力した場合のための保険)
*.csv

# エディタ・IDE
.vscode/
.idea/
*.swp

# OS が勝手に作るファイル
.DS_Store
Thumbs.db

# Windows で Unblock-File する前の Zone.Identifier が
# WSL 側から見えた場合の残骸
*:Zone.Identifier

# ESP-IDF (m1-esp32/)
m1-esp32/build/
m1-esp32/managed_components/
m1-esp32/sdkconfig
m1-esp32/sdkconfig.old
m1-esp32/dependencies.lock

# ESP-IDF (m2-esp32/)
m2-esp32/build/
m2-esp32/managed_components/
m2-esp32/sdkconfig
m2-esp32/sdkconfig.old
m2-esp32/dependencies.lock

# ESP-IDF (node-esp32/ = 発注7の汎用ノードファーム)
node-esp32/build/
node-esp32/managed_components/
node-esp32/sdkconfig
node-esp32/sdkconfig.old
node-esp32/dependencies.lock

# MQTT観測ログ (scripts/mqtt_observe.py)
mqtt_log/

# Python のバイトコードキャッシュ
__pycache__/

# Python の仮想環境 (PC側ツールの依存ライブラリはここに入れる。グローバル環境を汚さない)
.venv/

# AOT実験の生成物 (wamrcで再生成できるためコミットしない)
*.aot

# demo outputs (scripts/demo_task*.ps1)
demo_out/
swarm_out/

# 群れ移植の実験出力 (dyne-swarm-sim / 参照実装の比較実行。再生成可能)
swarm_sim_out/
swarm_old_out/

# F1/F2 の手元確認出力 (scripts/check-f1.ps1。再生成可能)
f1_check_out/


# 発表スライド (Googleスライドで管理するため追跡しない。生成スクリプトと構成案のみ追跡)
reference/previous_deck.pptx
reference/previous_deck.pdf
slides/**/*.pptx
slides/**/formula_imgs/
slides/**/final.md
slides/**/old25_degradation.jpg

# 会話記録から復元した実測データ (recovered/) は *.csv の例外として追跡する
# (元CSVがOSの一時領域の清掃で消失した事故の再発防止。詳細は recovered/README.md)
!recovered/*.csv

# 実機実測の記録 (measured/) も *.csv の例外として追跡する (実測の正本。詳細は measured/README.md)
!measured/**/*.csv

# ESP-IDF のパーティションテーブル (フラッシュの使い方の表) はソースなので追跡する (2026-11-15)
!node-esp32/partitions_*.csv
!bench-c5/partitions_*.csv

# ESP-IDF (vl53-eval/ = VL53L5CX評価用ファーム)
vl53-eval/build/
vl53-eval/managed_components/
vl53-eval/sdkconfig
vl53-eval/sdkconfig.old
vl53-eval/dependencies.lock

# ESP-IDF (bench-c5/ = WASMアクターの速度・メモリ計測ファーム。方式・ターゲット別に build-*/ を作る)
bench-c5/build/
bench-c5/build-*/
bench-c5/managed_components/
bench-c5/sdkconfig
bench-c5/sdkconfig.old
bench-c5/dependencies.lock
# bench-c5 の2次元の再生の記録 (計約1.1MB、tools/interp_bench.py make で再生成できる)
bench-c5/assets/*.rec

# node-esp32/ の ESP32-C5 向けの別ビルド (idf.py -B build-c5 -D SDKCONFIG=build-c5/sdkconfig。既定の build/・sdkconfig は ESP32 のまま)
node-esp32/build-c5/

# node-esp32/ の OTA 対応版のビルド (node-esp32/build.ps1。ターゲットごとに build-ota-esp32/・build-ota-esp32c5/、sdkconfig もその中)
node-esp32/build-ota-*/
# node-esp32/build.ps1 が重ねる手元の設定 (Wi-Fi の SSID・パスワード・ブローカーの URI。2026-11-13)
node-esp32/sdkconfig.local
# 最初の USB 書き込みの記録 (scripts/first_flash.py。first_flash.csv = MAC とノード番号の対応、logs/ = 起動のログ。2026-11-15)
first_flash_out/
# 波動方程式のノード群の実行の記録 (scripts/wave2d_cluster.py。nodes.json = ノードの IP、実行ごとの設定・結果・MQTT の記録。2026-11-16)
wave2d_out/

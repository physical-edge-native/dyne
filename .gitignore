# Rust ビルド成果物
# ワークスペース (dyne-host, dyne-proto) のビルド出力
/target/
# 発注11の分離ビルド出力 (--target-dir target-exp1。full432掃引中の
# target/release ロック回避と掃引バイナリの由来保全のため分離)
/target-exp1/
# ワークスペース外で別ビルドするアクターは個別に指定
/crates/heat1d-actor/target/
/crates/heat1d-pinn-actor/target/
/crates/swarm-agent-actor/target/

# Cargo.lock の方針:
# - dyne-host はバイナリなので Cargo.lock をコミットするのが Rust の慣例
#   (再現ビルドのため)。よってワークスペース直下の Cargo.lock は無視しない。
# - heat1d-actor 側の Cargo.lock も同様にコミット対象とする (無視しない)。

# 実行時の出力 (CSV は既定で %TEMP% / /tmp に出るが、リポジトリ内に
# 出力した場合のための保険)
*.csv

# エディタ・IDE
.vscode/
.idea/
*.swp

# OS が勝手に作るファイル
.DS_Store
Thumbs.db

# Windows で Unblock-File する前の Zone.Identifier が
# WSL 側から見えた場合の残骸
*:Zone.Identifier

# ESP-IDF (m1-esp32/)
m1-esp32/build/
m1-esp32/managed_components/
m1-esp32/sdkconfig
m1-esp32/sdkconfig.old
m1-esp32/dependencies.lock

# ESP-IDF (m2-esp32/)
m2-esp32/build/
m2-esp32/managed_components/
m2-esp32/sdkconfig
m2-esp32/sdkconfig.old
m2-esp32/dependencies.lock

# ESP-IDF (node-esp32/ = 発注7の汎用ノードファーム)
node-esp32/build/
node-esp32/managed_components/
node-esp32/sdkconfig
node-esp32/sdkconfig.old
node-esp32/dependencies.lock

# MQTT観測ログ (scripts/mqtt_observe.py)
mqtt_log/

# Python のバイトコードキャッシュ
__pycache__/

# AOT実験の生成物 (wamrcで再生成できるためコミットしない)
*.aot

# demo outputs (scripts/demo_task*.ps1)
demo_out/
swarm_out/

# 群れ移植の実験出力 (dyne-swarm-sim / 参照実装の比較実行。再生成可能)
swarm_sim_out/
swarm_old_out/

# F1/F2 の手元確認出力 (scripts/check-f1.ps1。再生成可能)
f1_check_out/


# 発表スライド (Googleスライドで管理するため追跡しない。生成スクリプトと構成案のみ追跡)
reference/previous_deck.pptx
reference/previous_deck.pdf
slides/**/*.pptx
slides/**/formula_imgs/
slides/**/final.md
slides/**/old25_degradation.jpg

# 会話記録から復元した実測データ (recovered/) は *.csv の例外として追跡する
# (元CSVがOSの一時領域の清掃で消失した事故の再発防止。詳細は recovered/README.md)
!recovered/*.csv

# 実機実測の記録 (measured/) も *.csv の例外として追跡する (実測の正本。詳細は measured/README.md)
!measured/**/*.csv

# ESP-IDF (vl53-eval/ = VL53L5CX評価用ファーム)
vl53-eval/build/
vl53-eval/managed_components/
vl53-eval/sdkconfig
vl53-eval/sdkconfig.old
vl53-eval/dependencies.lock

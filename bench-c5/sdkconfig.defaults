# bench-c5 の共通設定 (全ターゲット・全実行方式)
# 実行方式ごとの差分は sdkconfig.fast / sdkconfig.aot を重ねる (build.ps1 参照)

# シリアル (vl53-eval と同じ 921600bps。USBシリアル/JTAG 経由なら速度は無関係)
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# node-esp32 と同じく速度優先の最適化
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# 計測は数秒間 CPU を占有するので、タスク監視の警告で計測を乱さない
CONFIG_ESP_TASK_WDT_EN=n

# WAMR: 既定は Classic インタプリタ (node-esp32 と同じ)。AOT の読み込み機能は常に組み込む
CONFIG_WAMR_ENABLE_INTERP=y
CONFIG_WAMR_INTERP_CLASSIC=y
CONFIG_WAMR_ENABLE_AOT=y
# アクターは外部関数を何も呼ばない (import なし) ので、不要な機能を外してメモリを測りやすくする
CONFIG_WAMR_ENABLE_APP_FRAMEWORK=n
CONFIG_WAMR_ENABLE_LIB_PTHREAD=n
CONFIG_WAMR_ENABLE_LIBC_WASI=n
# 2026-11-11: rustc 1.82 以降の wasm32 は既定で reference types を使う (call_indirect の表番号の符号化)。
# 無効だと新しくビルドした計算部品が "zero byte expected" で読み込めない (ESPr の計測で判明)
CONFIG_WAMR_ENABLE_REF_TYPES=y
